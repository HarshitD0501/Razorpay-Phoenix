# Razorpay TEST mode. Dashboard → Account & Settings → API Keys → Generate Key.
# Test keys need no KYC. Secret shown once — download it.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard → Settings → Webhooks. HMAC-SHA256 over the RAW request body.
RAZORPAY_WEBHOOK_SECRET=phoenix_local_secret

# L1 classifier — Gemini 2.5 Flash. Absent → deterministic lookup table
# (arm D collapses to arm C, and the eval prints that it did).
# aistudio.google.com/apikey. Either name works; GOOGLE_GENERATIVE_AI_API_KEY is
# what the AI SDK reads, GEMINI_API_KEY is what Google's console hands you.
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=

# Twilio WhatsApp sandbox: Console → Messaging → Try it out → Send a WhatsApp message.
# Recipient must first send "join <two-word-code>" to +14155238886.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEMO_CUSTOMER_WHATSAPP=whatsapp:+919876543210

# Master switch. false = no network calls at all. Nothing charges while false.
PHOENIX_LIVE_EXECUTION=false

# Ledger is an append-only JSONL file. No database to provision.
PHOENIX_LEDGER=./data/ledger.jsonl
